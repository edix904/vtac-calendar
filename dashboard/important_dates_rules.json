{
  "version": "2026-10-19",
  "_doc": "Rules for the Calendar Dashboard's Important_Dates tab (dashboard/ImportantDates.js). The sync fetches this file from main on every run. standalone: milestones or titles (regex) that are deadlines on their own, so an opening or closing without a partner is not flagged. theme_rules: first pattern (case-insensitive regex) that matches the event's milestone, else its title, sets the theme. decisions: corrections from the daily Claude review (dashboard/review/REVIEW.md); listing keys are 'CAMPUS|YYYY-MM-DD|title' exactly as in dashboard/snapshot/listings.json.",
  "themes": [
    "Teaching periods", "Orientation", "Census dates", "Fees", "Timetables", "Assessments", "Results",
    "Graduations", "Scholarships", "Course transfers", "Re-enrolment", "University closed", "Public holidays",
    "VTAC", "Other"
  ],
  "theme_rules": [
    { "theme": "VTAC", "pattern": "^VTAC\\b" },
    { "theme": "University closed", "pattern": "^University (closed|reopens)" },
    { "theme": "Public holidays", "pattern": "^Public holiday" },
    { "theme": "Results", "pattern": "\\bresults?\\b" },
    { "theme": "Assessments", "pattern": "assessment|\\bexams?\\b|\\btests?\\b" },
    { "theme": "Timetables", "pattern": "^Allocate\\+|class timetable" },
    { "theme": "Census dates", "pattern": "^Census date|^Last day to (add|withdraw|discontinue)" },
    { "theme": "Fees", "pattern": "^Fees? |fee refund|^CAN released|SA-HELP|Commonwealth Assistance Notice" },
    { "theme": "Course transfers", "pattern": "^Course transfer" },
    { "theme": "Scholarships", "pattern": "scholarship" },
    { "theme": "Graduations", "pattern": "^Graduat" },
    { "theme": "Orientation", "pattern": "orientation" },
    { "theme": "Re-enrolment", "pattern": "^(Re-)?enrolment" },
    { "theme": "Teaching periods", "pattern": "^(Teaching|Mid-semester break|Swot vac)\\b" }
  ],
  "standalone": [
    "^VTAC preferences close", "^VTAC applications close: (Late|Very late)", "^Course transfer offer acceptance closes",
    "^Course transfer preferences close", "^Daylight saving", "^Enrolment starts", "^Pre-orientation starts"
  ],
  "decisions": {
    "exclude": [],
    "unpair": [],
    "pair": [],
    "merge": [],
    "separate": [],
    "set": [],
    "add": []
  }
}
